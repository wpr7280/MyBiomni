{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Skill Metadata",
  "description": "Schema for skill.yaml — the metadata file at the root of each skill directory.",
  "type": "object",
  "required": ["name"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "description": "Unique skill identifier (snake_case). Must match the directory name.",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "display_name": {
      "type": "string",
      "description": "Human-readable name for the skill."
    },
    "version": {
      "type": "string",
      "description": "Semantic version string.",
      "default": "1.0.0"
    },
    "category": {
      "type": "string",
      "description": "Domain / subject category (e.g. single_cell, genetics, pharmacology)."
    },
    "description": {
      "type": "string",
      "description": "A paragraph describing what this skill does."
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "role": { "type": "string", "default": "contributor" }
        }
      }
    },
    "license": { "type": "string" },
    "commercial_use": { "type": "boolean", "default": true },
    "dependencies": {
      "type": "object",
      "properties": {
        "python_packages": {
          "type": "array",
          "items": { "type": "string" }
        },
        "data_lake": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "tools": {
      "type": "array",
      "description": "List of tool names declared in tools/*.yaml.",
      "items": { "type": "string" }
    },
    "triggers": {
      "type": "array",
      "description": "Keywords or phrases that help match this skill to user queries.",
      "items": { "type": "string" }
    },
    "enabled": {
      "type": "boolean",
      "description": "Whether this skill is active.",
      "default": true
    }
  }
}
