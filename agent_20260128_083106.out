Now let me create a quantitative model to demonstrate how perturbations affect protein expression:
<execute>
print("="*80)
print("PERTURBATION EFFECTS ON PROTEIN EXPRESSION: QUANTITATIVE MODEL")
print("="*80)
print()

# Create a comprehensive model showing how different perturbations affect protein dynamics
class ProteinExpressionModel:
    """
    Model protein expression dynamics: DNA -> mRNA -> Protein
    Perturbations can affect transcription, translation, and degradation rates
    """
    
    def __init__(self, k_transcription=1.0, k_translation=2.0, 
                 k_mRNA_deg=0.1, k_protein_deg=0.05):
        """
        Parameters:
        - k_transcription: transcription rate (mRNA/time)
        - k_translation: translation rate (protein/mRNA/time)
        - k_mRNA_deg: mRNA degradation rate (1/time)
        - k_protein_deg: protein degradation rate (1/time)
        """
        self.k_transcription = k_transcription
        self.k_translation = k_translation
        self.k_mRNA_deg = k_mRNA_deg
        self.k_protein_deg = k_protein_deg
    
    def simulate(self, time_points, mRNA_init=0, protein_init=0):
        """Simulate mRNA and protein dynamics"""
        mRNA = np.zeros(len(time_points))
        protein = np.zeros(len(time_points))
        
        mRNA[0] = mRNA_init
        protein[0] = protein_init
        
        dt = time_points[1] - time_points[0] if len(time_points) > 1 else 1
        
        for i in range(1, len(time_points)):
            # mRNA: transcription - degradation
            dmRNA = self.k_transcription - self.k_mRNA_deg * mRNA[i-1]
            mRNA[i] = mRNA[i-1] + dmRNA * dt
            
            # Protein: translation - degradation
            dprotein = self.k_translation * mRNA[i-1] - self.k_protein_deg * protein[i-1]
            protein[i] = protein[i-1] + dprotein * dt
        
        return mRNA, protein
    
    def steady_state(self):
        """Calculate steady-state mRNA and protein levels"""
        mRNA_ss = self.k_transcription / self.k_mRNA_deg
        protein_ss = (self.k_translation * mRNA_ss) / self.k_protein_deg
        return mRNA_ss, protein_ss

# Simulate different perturbations
time_points = np.linspace(0, 100, 1000)

# 1. Wild-type baseline
wt_model = ProteinExpressionModel(k_transcription=1.0, k_translation=2.0, 
                                   k_mRNA_deg=0.1, k_protein_deg=0.05)
wt_mRNA, wt_protein = wt_model.simulate(time_points)

# 2. CRISPR knockout (transcription = 0)
ko_model = ProteinExpressionModel(k_transcription=0.0, k_translation=2.0, 
                                   k_mRNA_deg=0.1, k_protein_deg=0.05)
ko_mRNA, ko_protein = ko_model.simulate(time_points, mRNA_init=wt_mRNA[0], 
                                         protein_init=wt_protein[0])

# 3. Transcriptional activation (2x transcription)
act_model = ProteinExpressionModel(k_transcription=2.0, k_translation=2.0, 
                                    k_mRNA_deg=0.1, k_protein_deg=0.05)
act_mRNA, act_protein = act_model.simulate(time_points)

# 4. Translation inhibition (50% reduction)
transl_inh_model = ProteinExpressionModel(k_transcription=1.0, k_translation=1.0, 
                                          k_mRNA_deg=0.1, k_protein_deg=0.05)
transl_inh_mRNA, transl_inh_protein = transl_inh_model.simulate(time_points)

# 5. Increased protein degradation (2x)
deg_model = ProteinExpressionModel(k_transcription=1.0, k_translation=2.0, 
                                    k_mRNA_deg=0.1, k_protein_deg=0.1)
deg_mRNA, deg_protein = deg_model.simulate(time_points)

# 6. mRNA instability (2x mRNA degradation)
mRNA_unstable_model = ProteinExpressionModel(k_transcription=1.0, k_translation=2.0, 
                                             k_mRNA_deg=0.2, k_protein_deg=0.05)
mRNA_unstable_mRNA, mRNA_unstable_protein = mRNA_unstable_model.simulate(time_points)

# Plot results
fig, axes = plt.subplots(2, 1, figsize=(14, 10))

# mRNA dynamics
ax = axes[0]
ax.plot(time_points, wt_mRNA, label='Wild-type', linewidth=2.5, color='black')
ax.plot(time_points, ko_mRNA, label='CRISPR knockout', linewidth=2.5, color='red', linestyle='--')
ax.plot(time_points, act_mRNA, label='Transcriptional activation', linewidth=2.5, color='green')
ax.plot(time_points, transl_inh_mRNA, label='Translation inhibition', linewidth=2.5, color='blue')
ax.plot(time_points, mRNA_unstable_mRNA, label='mRNA instability', linewidth=2.5, color='orange')
ax.set_xlabel('Time', fontsize=12)
ax.set_ylabel('mRNA level', fontsize=12)
ax.set_title('Effect of Different Perturbations on mRNA Expression', fontsize=13, fontweight='bold')
ax.legend(fontsize=10)
ax.grid(True, alpha=0.3)

# Protein dynamics
ax = axes[1]
ax.plot(time_points, wt_protein, label='Wild-type', linewidth=2.5, color='black')
ax.plot(time_points, ko_protein, label='CRISPR knockout', linewidth=2.5, color='red', linestyle='--')
ax.plot(time_points, act_protein, label='Transcriptional activation', linewidth=2.5, color='green')
ax.plot(time_points, transl_inh_protein, label='Translation inhibition', linewidth=2.5, color='blue')
ax.plot(time_points, deg_protein, label='Increased protein degradation', linewidth=2.5, color='purple')
ax.plot(time_points, mRNA_unstable_protein, label='mRNA instability', linewidth=2.5, color='orange')
ax.set_xlabel('Time', fontsize=12)
ax.set_ylabel('Protein level', fontsize=12)
ax.set_title('Effect of Different Perturbations on Protein Expression', fontsize=13, fontweight='bold')
ax.legend(fontsize=10)
ax.grid(True, alpha=0.3)

plt.tight_layout()
plt.savefig('perturbation_effects_dynamics.png', dpi=300, bbox_inches='tight')
plt.show()

print("✓ Simulation complete: Different perturbations show distinct effects on protein dynamics")
print()

# Calculate steady-state effects
print("STEADY-STATE EFFECTS OF PERTURBATIONS:")
print("-" * 80)
print(f"{'Perturbation':<40} {'mRNA level':<15} {'Protein level':<15} {'% Change':<10}")
print("-" * 80)

wt_mRNA_ss, wt_protein_ss = wt_model.steady_state()

perturbations = [
    ("Wild-type (baseline)", wt_model),
    ("CRISPR knockout", ko_model),
    ("Transcriptional activation (2x)", act_model),
    ("Translation inhibition (50%)", transl_inh_model),
    ("Protein degradation (2x)", deg_model),
    ("mRNA instability (2x)", mRNA_unstable_model),
]

for name, model in perturbations:
    mRNA_ss, protein_ss = model.steady_state()
    pct_change = ((protein_ss - wt_protein_ss) / wt_protein_ss * 100) if wt_protein_ss > 0 else 0
    print(f"{name:<40} {mRNA_ss:>14.2f} {protein_ss:>14.2f} {pct_change:>9.1f}%")

print()
</execute>

