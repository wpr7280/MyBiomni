            "Morpholino": "Best for: Temporal control, development | Cost: Moderate | Time: Variable",
            "Small molecule": "Best for: Rapid, reversible, translational | Cost: Moderate-High | Time: 30m-24h",
            "Environmental": "Best for: Physiological relevance, stress | Cost: Low | Time: 1-24h"
        }
    },
    
    "STEP 2: SAMPLE PREPARATION": {
        "Cell culture": [
            "□ Culture cells under standard conditions",
            "□ Verify cell identity (STR profiling if available)",
            "□ Check mycoplasma status",
            "□ Document passage number",
            "□ Ensure consistent cell density at perturbation"
        ],
        "Perturbation application": [
            "□ Prepare perturbation reagent (verify concentration/titer)",
            "□ Apply to cells at designated time (T=0)",
            "□ Include untreated controls (same conditions)",
            "□ Document exact timing for all samples",
            "□ Maintain consistent culture conditions"
        ],
        "Sample collection": [
            "□ Collect at planned timepoints",
            "□ Use consistent lysis buffer/method",
            "□ Snap freeze samples if storing",
            "□ Document collection time for all samples",
            "□ Maintain sample integrity (avoid degradation)"
        ]
    },
    
    "STEP 3: QUALITY CONTROL": {
        "Verify perturbation": [
            "□ Confirm target knockdown (>70% for functional studies)",
            "□ Check for cell death/toxicity (>90% viability required)",
            "□ Assess proliferation rate",
            "□ Validate with independent method if possible",
            "□ Document any incomplete or off-target effects"
        ],
        "Assess data quality": [
            "□ RNA integrity (RIN >7 for RNA-seq)",
            "□ Protein concentration consistency",
            "□ Sequencing quality (Q30 >80% for RNA-seq)",
            "□ Replicate correlation (R² >0.8 typical)",
            "□ Identify and document outliers"
        ]
    },
    
    "STEP 4: DATA NORMALIZATION": {
        "For mRNA analysis": [
            "□ Use size factor normalization (DESeq2) or CPM",
            "□ Select stable housekeeping genes as reference",
            "□ Check for batch effects (PCA plot)",
            "□ Apply batch correction if needed (ComBat, SVA)",
            "□ Log-transform for visualization"
        ],
        "For protein analysis": [
            "□ Normalize to loading control (β-actin, GAPDH, tubulin)",
            "□ Account for total protein loading",
            "□ Correct for lane-to-lane variation",
            "□ Use densitometry software for quantification",
            "□ Calculate fold-change relative to control"
        ]
    },
    
    "STEP 5: QUANTIFY EFFECTS": {
        "Calculate fold-change": [
            "□ Fold-change = Perturbed / Control (or log2-transformed)",
            "□ Report with 95% confidence intervals",
            "□ Calculate standard error across replicates",
            "□ Note minimum detectable fold-change"
        ],
        "Statistical testing": [
            "□ Choose appropriate test (t-test, ANOVA, Welch's test)",
            "□ Check assumptions (normality, equal variance)",
            "□ Calculate p-values and effect sizes",
            "□ Adjust for multiple comparisons (FDR, Bonferroni)",
            "□ Report adjusted p-values"
        ],
        "Classify effects": [
            "□ Significant upregulation (log2FC >1, padj <0.05)",
            "□ Significant downregulation (log2FC <-1, padj <0.05)",
            "□ Modest changes (0.5 < |log2FC| < 1)",
            "□ Non-significant (|log2FC| < 0.5 or padj >0.05)"
        ]
    },
    
    "STEP 6: ANALYZE DYNAMICS": {
        "For time-course data": [
            "□ Plot expression over time for each gene",
            "□ Identify response kinetics (immediate, early, late)",
            "□ Fit exponential or sigmoidal curves",
            "□ Calculate lag time (delay before response)",
            "□ Determine steady-state levels",
            "□ Compare kinetics across genes"
        ],
        "Clustering analysis": [
            "□ Group genes by similar response patterns",
            "□ Use k-means or hierarchical clustering",
            "□ Visualize with heatmaps",
            "□ Identify co-regulated gene sets",
            "□ Perform GO/pathway enrichment on clusters"
        ]
    },
    
    "STEP 7: INTERPRET RESULTS": {
        "Distinguish effect types": [
            "□ Direct effects: Immediate, strong response",
            "□ Primary indirect: Affect target's direct regulators",
            "□ Secondary indirect: Affect downstream pathways",
            "□ Compensatory: Upregulation of paralogs/redundant genes",
            "□ Stress response: Generic stress markers (HSP, p53 targets)"
        ],
        "Pathway analysis": [
            "□ Perform GO enrichment on upregulated genes",
            "□ Perform GO enrichment on downregulated genes",
            "□ Map to known pathways (KEGG, Reactome)",
            "□ Identify pathway modules and hub genes",
            "□ Compare to disease signatures"
        ],
        "Network analysis": [
            "□ Build co-expression network",
            "□ Identify network modules",
            "□ Find hub genes (highly connected)",
            "□ Assess network rewiring after perturbation",
            "□ Predict new regulatory relationships"
        ]
    },
    
    "STEP 8: VALIDATION": {
        "Independent method": [
            "□ Confirm key findings with different technique",
            "□ Example: RNA-seq → qRT-PCR validation",
            "□ Example: Western blot → Flow cytometry",
            "□ Validate ≥3 differentially expressed genes"
        ],
        "Biological validation": [
            "□ Rescue experiment (add back target if knockout)",
            "□ Test in different cell type",
            "□ Test in relevant disease model",
            "□ Link molecular changes to functional outcome"
        ],
        "Literature comparison": [
            "□ Compare to published studies",
            "□ Check for conflicting results",
            "□ Note any unexpected findings",
            "□ Discuss potential explanations"
        ]
    }
}

for step, details in workflow.items():
    print(f"\n{step}")
    print("=" * 80)
    for subsection, items in details.items():
        print(f"\n{subsection}:")
        if isinstance(items, dict):
            for key, value in items.items():
                print(f"  {key}: {value}")
        else:
            for item in items:
                print(f"  {item}")

print("\n")
