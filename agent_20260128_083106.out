import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from scipy import stats
import warnings
warnings.filterwarnings('ignore')

# Set visualization style
sns.set_style("whitegrid")
plt.rcParams['figure.figsize'] = (12, 6)

print("="*80)
print("PROTEIN EXPRESSION PERTURBATION ANALYSIS FRAMEWORK")
print("="*80)
print()

# Define types of perturbations
perturbation_types = {
    "Genetic": {
        "description": "Alterations in gene sequence or copy number",
        "examples": ["CRISPR knockout", "Gene knockdown", "Overexpression", "Point mutations"],
        "typical_effects": ["Loss of function", "Gain of function", "Altered stability"]
    },
    "Epigenetic": {
        "description": "Changes in chromatin state and gene regulation",
        "examples": ["DNA methylation", "Histone modification", "Chromatin remodeling"],
        "typical_effects": ["Gene silencing", "Transcriptional activation", "Altered accessibility"]
    },
    "Transcriptional": {
        "description": "Modulation of transcription factors and regulatory elements",
        "examples": ["TF knockdown", "Promoter mutation", "Enhancer deletion"],
        "typical_effects": ["Reduced mRNA", "Altered splicing", "Changed expression kinetics"]
    },
    "Post-transcriptional": {
        "description": "Changes in RNA processing and stability",
        "examples": ["miRNA inhibition", "RNA degradation", "Alternative splicing"],
        "typical_effects": ["mRNA instability", "Reduced translation", "Isoform shifts"]
    },
    "Translational": {
        "description": "Alterations in protein synthesis",
        "examples": ["Ribosome inhibition", "tRNA depletion", "Codon optimization"],
        "typical_effects": ["Reduced protein synthesis", "Altered protein folding"]
    },
    "Post-translational": {
        "description": "Modifications after protein synthesis",
        "examples": ["Phosphorylation", "Ubiquitination", "Proteolysis"],
        "typical_effects": ["Activation/inactivation", "Localization change", "Protein degradation"]
    },
    "Environmental": {
        "description": "External conditions affecting expression",
        "examples": ["Temperature", "Nutrient starvation", "Hypoxia", "Drug treatment"],
        "typical_effects": ["Stress response", "Metabolic remodeling", "Cell fate change"]
    }
}

print("TYPES OF PERTURBATIONS AND THEIR EFFECTS ON PROTEIN EXPRESSION:\n")
for ptype, details in perturbation_types.items():
    print(f"{ptype}:")
    print(f"  Description: {details['description']}")
    print(f"  Examples: {', '.join(details['examples'])}")
    print(f"  Typical Effects: {', '.join(details['typical_effects'])}")
