Now let me demonstrate real-world analysis using actual data:
<execute>
print("="*80)
print("REAL-WORLD EXAMPLE: CRISPR PERTURBATION ANALYSIS")
print("="*80)
print()

# Load DepMap CRISPR data to analyze actual perturbation effects
try:
    # Load CRISPR gene effect data
    crispr_data = pd.read_csv('./data/biomni_data/data_lake/DepMap_CRISPRGeneEffect.csv', 
                               index_col=0, nrows=100)  # Load subset for demo
    
    # Load expression data
    expr_data = pd.read_csv('./data/biomni_data/data_lake/DepMap_OmicsExpressionProteinCodingGenesTPMLogp1.csv',
                             index_col=0, nrows=100)
    
    print(f"CRISPR data shape: {crispr_data.shape}")
    print(f"Expression data shape: {expr_data.shape}")
    print()
    
    # Find overlapping genes
    common_genes = list(set(crispr_data.columns) & set(expr_data.columns))[:10]
    print(f"Found {len(common_genes)} common genes for analysis")
    print(f"Example genes: {common_genes[:5]}")
    print()
    
    # Analyze correlation between CRISPR knockout effect and baseline expression
    print("ANALYSIS: CRISPR Knockout Effect vs Baseline Expression")
    print("-" * 80)
    
    correlations = []
    for gene in common_genes:
        if gene in crispr_data.columns and gene in expr_data.columns:
            # Get CRISPR effect (negative = essential, knockout reduces fitness)
            crispr_effect = crispr_data[gene].dropna()
            
            # Get baseline expression
            expr_level = expr_data[gene].dropna()
            
            # Find common cell lines
            common_cl = list(set(crispr_effect.index) & set(expr_level.index))
            
            if len(common_cl) > 5:
                crispr_effect_common = crispr_effect.loc[common_cl]
                expr_level_common = expr_level.loc[common_cl]
                
                # Calculate correlation
                corr, pval = stats.pearsonr(crispr_effect_common, expr_level_common)
                correlations.append({
                    'Gene': gene,
                    'Correlation': corr,
                    'P-value': pval,
                    'N_celllines': len(common_cl),
                    'Avg_CRISPR_effect': crispr_effect_common.mean(),
                    'Avg_Expression': expr_level_common.mean()
                })
    
    if correlations:
        corr_df = pd.DataFrame(correlations)
        print(corr_df.to_string(index=False))
        print()
        print("Interpretation:")
        print("- Positive correlation: High expression genes tend to have stronger knockout effects")
        print("- Negative correlation: Expression level inversely related to knockout essentiality")
        print()
    
except Exception as e:
    print(f"Note: Could not load DepMap data ({e})")
    print("Proceeding with synthetic example instead...")
    print()
