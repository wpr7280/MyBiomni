best_practices = {
    "EXPERIMENTAL DESIGN": {
        "1. Define clear objectives": [
            "• Understand mechanism of action",
            "• Identify essential genes",
            "• Validate therapeutic targets",
            "• Characterize drug response"
        ],
        "2. Choose appropriate perturbation method": [
