Now let me create visualizations showing different perturbation scenarios:
<execute>
print("="*80)
print("PERTURBATION RESPONSE PATTERNS: VISUALIZATION")
print("="*80)
print()

# Create comprehensive visualization of different perturbation response patterns
fig, axes = plt.subplots(2, 3, figsize=(16, 10))

# Define time course
time = np.linspace(0, 48, 100)  # 48 hours

# 1. Immediate response (phosphorylation)
ax = axes[0, 0]
baseline = np.ones_like(time) * 100
perturbation_applied = np.where(time > 5, 1, 0)
response = baseline + perturbation_applied * (200 * np.exp(-0.5 * (time - 5)))
ax.plot(time, baseline, 'k--', label='Baseline', linewidth=2)
ax.plot(time, response, 'r-', label='After perturbation', linewidth=2.5)
ax.axvline(5, color='gray', linestyle=':', alpha=0.5)
ax.set_title('Immediate Response\n(Post-translational)', fontweight='bold')
ax.set_xlabel('Time (hours)')
ax.set_ylabel('Signal intensity')
ax.legend()
ax.grid(True, alpha=0.3)

# 2. Early response (mRNA induction)
ax = axes[0, 1]
baseline = np.ones_like(time) * 100
response = baseline + np.where(time > 5, 1, 0) * (300 * (1 - np.exp(-0.3 * (time - 5))))
response = np.minimum(response, baseline + 300)
ax.plot(time, baseline, 'k--', label='Baseline', linewidth=2)
ax.plot(time, response, 'g-', label='After perturbation', linewidth=2.5)
ax.axvline(5, color='gray', linestyle=':', alpha=0.5)
ax.set_title('Early Response\n(mRNA induction)', fontweight='bold')
ax.set_xlabel('Time (hours)')
ax.set_ylabel('mRNA level (fold)')
ax.legend()
ax.grid(True, alpha=0.3)

# 3. Intermediate response (protein accumulation)
ax = axes[0, 2]
baseline = np.ones_like(time) * 100
response = baseline + np.where(time > 5, 1, 0) * (400 * (1 - np.exp(-0.15 * (time - 5))))
response = np.minimum(response, baseline + 400)
ax.plot(time, baseline, 'k--', label='Baseline', linewidth=2)
ax.plot(time, response, 'b-', label='After perturbation', linewidth=2.5)
ax.axvline(5, color='gray', linestyle=':', alpha=0.5)
ax.set_title('Intermediate Response\n(Protein accumulation)', fontweight='bold')
ax.set_xlabel('Time (hours)')
ax.set_ylabel('Protein level (fold)')
ax.legend()
ax.grid(True, alpha=0.3)

# 4. Knockout effect (complete loss)
ax = axes[1, 0]
baseline = np.ones_like(time) * 100
response = baseline - np.where(time > 5, 1, 0) * (100 * (1 - np.exp(-0.1 * (time - 5))))
response = np.maximum(response, 0)
ax.plot(time, baseline, 'k--', label='Wild-type', linewidth=2)
ax.plot(time, response, 'r-', label='CRISPR knockout', linewidth=2.5)
ax.axvline(5, color='gray', linestyle=':', alpha=0.5)
ax.set_title('Knockout Effect\n(Complete loss)', fontweight='bold')
ax.set_xlabel('Time (hours)')
ax.set_ylabel('Protein level')
ax.legend()
ax.grid(True, alpha=0.3)

# 5. Compensatory response (feedback)
ax = axes[1, 1]
baseline = np.ones_like(time) * 100
# Initial drop, then compensation
response = baseline - np.where(time > 5, 1, 0) * (150 * np.exp(-0.2 * (time - 5)))
response += np.where(time > 15, 1, 0) * (150 * (1 - np.exp(-0.15 * (time - 15))))
ax.plot(time, baseline, 'k--', label='Baseline', linewidth=2)
ax.plot(time, response, 'purple', label='With compensation', linewidth=2.5)
ax.axvline(5, color='gray', linestyle=':', alpha=0.5)
ax.set_title('Compensatory Response\n(Feedback activation)', fontweight='bold')
ax.set_xlabel('Time (hours)')
ax.set_ylabel('Protein level')
ax.legend()
ax.grid(True, alpha=0.3)

# 6. Pleiotropic effect (multiple genes affected)
ax = axes[1, 2]
baseline = np.ones_like(time) * 100
target_gene = baseline - np.where(time > 5, 1, 0) * (100 * (1 - np.exp(-0.15 * (time - 5))))
target_gene = np.maximum(target_gene, 0)
off_target_1 = baseline - np.where(time > 8, 1, 0) * (50 * (1 - np.exp(-0.1 * (time - 8))))
off_target_1 = np.maximum(off_target_1, 50)
off_target_2 = baseline + np.where(time > 10, 1, 0) * (80 * (1 - np.exp(-0.12 * (time - 10))))

ax.plot(time, baseline, 'k--', label='Baseline', linewidth=2)
ax.plot(time, target_gene, 'r-', label='Target gene', linewidth=2.5)
ax.plot(time, off_target_1, 'orange', label='Off-target 1', linewidth=2.5)
ax.plot(time, off_target_2, 'b-', label='Off-target 2', linewidth=2.5)
ax.axvline(5, color='gray', linestyle=':', alpha=0.5)
ax.set_title('Pleiotropic Effects\n(Multiple targets)', fontweight='bold')
ax.set_xlabel('Time (hours)')
ax.set_ylabel('Expression level')
ax.legend(fontsize=9)
ax.grid(True, alpha=0.3)

plt.tight_layout()
plt.savefig('perturbation_response_patterns.png', dpi=300, bbox_inches='tight')
plt.show()

print("✓ Visualization complete: Different perturbation response patterns")
print()
</execute>

